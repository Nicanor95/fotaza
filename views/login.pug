extends partials/layout

block content 
	form.center(action="/ingreso", method="post", enctype="application/json")
		label Usuario
		input(type="email", name="user")
		label Contraseña
		input(type="password", name="password")
		div.c_flex.botonera
			button.center(type="submit") Ingresar 
			a.center(href="/newuser") 
				button.center(type="button") Registrarse