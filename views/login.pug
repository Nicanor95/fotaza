extends partials/layout

block content 
	form.authform.center(method="post", enctype="application/json")
		label(for="email") Email
		input#email(type="email", name="email")
		span(hidden="true").error.startalign * Email invalido
		label(for="user") Contraseña
		input#password(type="password", name="password")
		span(hidden="true").error.startalign * Ingrese contraseña
		div.c_flex.botonera
			button.center(type="submit", onclick="validate(event)") Ingresar 
			a.center(href="/auth/signup") 
				button.center(type="button") Registrarse
	
	script(src="/script/login.js") 