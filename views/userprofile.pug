extends partials/layout
include partials/wall

block content
	div.profile 
		h1=profile_user.nombre 
		div.profile-stats
			span.stat-item <b>#{followers_count}</b> seguidores
			span.stat-item <b>#{followed_count}</b> siguiendo
		if user
			if user.id === profile_user.id
				a(href=`/users/${profile_user.id}/favoritos`).favoritos-link
					button(type="button").favoritos Mis favoritos
				a(href=`/users/${profile_user.id}/colecciones`).colecciones-link
					button(type="button").colecciones Mis colecciones
			else
				if follows
					form(action=`/users/${profile_user.id}/unfollow`, method="post")
						button(type="submit").unfollow Dejar de seguir
				else 
					form(method="post", enctype="application/json")
						button(type="submit").follow Seguir
		else 
			div.notice
				a(href="/auth/login") Inicia sesión para seguir

	hr
	+wall(wall_posts)
