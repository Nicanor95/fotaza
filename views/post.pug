extends partials/layout

block content
	div.post-page
		div.post-card
			div.slides-container
				each image in img_list 
					div.slide
						img.post_image(src=image.data)

				- let multiple = img_list? img_list.length > 1 : false;

				if multiple
					a.prev(onclick="moveSlide(-1)") &#10094;
					a.next(onclick="moveSlide(1)") &#10095;
			div.post-details
				h2=title
				if canEditPublication
					a(href=`/post/edit/${album_id}`).edit-post
						button(type="button") Editar publicación
				each image in img_list
					div.description.post-description.first
						div.options-wrapper.image-options
							button.options-button(type="button", aria-label="Opciones de la imagen", aria-expanded="false", aria-controls=`image-options-${image.id}`)
								i.fa-solid.fa-ellipsis-vertical(aria-hidden="true")
							ul.options-menu.hidden(id=`image-options-${image.id}`)
								li
									a.report-option(href=`/reportes/imagen/${image.id}`)
										i.fa-solid.fa-flag(aria-hidden="true")
										span Reportar imagen
						div.post_author
							a(href=`/users/${uploader.id}`)=uploader.nombre
							if user
								if uploader.id != user.id
									if follows
										form(action=`/users/${uploader.id}/unfollow`, method="post")
											button(type="submit").unfollow Dejar de seguir
									else 
										form(action=`/users/${uploader.id}`, method="post")
											button(type="submit").follow Seguir
						div.rating
							form(action=`/post/album/${album_id}/${image.id}/valorate`, method="post").ratingForm
								button(type="submit" name="valor", value="1").ratingButton 1
								button(type="submit" name="valor", value="2").ratingButton 2
								button(type="submit" name="valor", value="3").ratingButton 3
								button(type="submit" name="valor", value="4").ratingButton 4
								button(type="submit" name="valor", value="5").ratingButton 5
							span=image.rating
						div.image-action-bar
							div.image-action-group
								if user
									if !image.favoritos
										form(action=`/post/album/${album_id}/${image.id}/favourite`, method="post").image-action-form
											button(type="submit", title="Añadir a favoritos", aria-label="Añadir a favoritos").image-action
												i.fa-solid.fa-heart(aria-hidden="true")
									else
										form(action=`/post/album/${album_id}/${image.id}/unfavourite`, method="post").image-action-form
											button(type="submit", title="Quitar de favoritos", aria-label="Quitar de favoritos").image-action.is-favorite
												i.fa-solid.fa-heart(aria-hidden="true")
									a(href=`/users/${user.id}/coleccion/agregar/${image.id}?album_id=${album_id}`, title="Añadir a colección", aria-label="Añadir a colección").image-action
										i.fa-solid.fa-folder-plus(aria-hidden="true")
								form(action=`/chat/${image.id}`, method="post").image-action-form
									button(type="submit", title="Me interesa", aria-label="Me interesa").image-action
										i.fa-solid.fa-dollar-sign(aria-hidden="true")
						p=image.description
						each tag in image.tags
							span.tag=tag.name
					div.comments.post-comments.second(hidden)
						h3(tabindex="-1") Comentarios
						each comment in image.comments 
							div.comentario.comment-card
								div.comment-header
									a.comment_author(href=`/users/${comment.user.id}`)=comment.user.name
									if canViewReportCounts
										button.comment-report-count(type="button", data-comment-id=comment.id, aria-expanded="false", aria-controls="panelComentarioReportes")= `${comment.reportCount} reportes`
									div.options-wrapper.comment-options
										button.options-button(type="button", aria-label="Opciones del comentario", aria-expanded="false", aria-controls=`comment-options-${comment.id}`)
											i.fa-solid.fa-ellipsis-vertical
										ul.options-menu.hidden(id=`comment-options-${comment.id}`)
											li
												a.report-option(href=`/reportes/comentario/${comment.id}`)
													i.fa-solid.fa-flag(aria-hidden="true")
													span Reportar comentario
								p=comment.content

						if auth && image.comments_enabled
							form.r_flex.sendcomment(method="POST", action=("/post/album/" + album_id + "/" + image.id))
								input(type="text", name="contenido", required=true, placeholder="Escribe un comentario...")
								button(type="submit")
									i.fa-solid.fa-paper-plane
						else if !auth && image.comments_enabled
							div.notice
								a(href="/auth/login") Inicia sesión para comentar
						else
							div.notice Comentarios deshabilitados
		if canViewReportCounts
			div#panelComentarioReportes.side-panel.oculto(aria-hidden="true", role="dialog", aria-modal="false", aria-labelledby="tituloPanelComentarioReportes")
				button#btnCerrarPanelComentarioReportes.side-panel-close(type="button", aria-label="Cerrar reportes del comentario") ✕
				h3#tituloPanelComentarioReportes Reportes del comentario
				p#estadoPanelComentarioReportes(aria-live="polite") Selecciona un comentario para consultar sus reportes.
				ul#listaReportesComentario(aria-label="Detalles de los reportes del comentario")
				div#accionesReportesComentario.reporte-comentario-acciones
					button#btnDescartarReportesComentario(type="button") Descartar reportes
					button#btnEliminarComentarioReportado(type="button") Eliminar comentario

	script(src="/script/album.js")
	if canViewReportCounts
		script(src="/script/comentario-reportes.js")
