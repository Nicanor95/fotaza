doctype html
html(lang="en")
	head
		include head.pug
		title= title || "Fotaza"
	body 
		header
			div.header-brand
				a#icon(href="/")
					h1 F
				include navigation.pug
			include searchbar.pug
			include user.pug
		main
			block content
		footer
			a(href="mailto://fotaza@foo.baz" title="Contact through Email")
				i(class="fa-solid fa-envelope")
	script(src="/script/notificaciones.js", defer=true)
	if user && user.moderador
		script(src="/script/reportes.js", defer=true)
