mixin wall(wall_posts, pagination)
	div.r_flex.center.wall
		each p in wall_posts
			a.post(href=`/post/album/${p.publicacion_id}/${p.id}`)
				img(src=`${p.img_b64}`, width=300, height=600)
				h3 #{p.titulo}
	if pagination && pagination.totalPages > 1
		nav.pagination.center
			if pagination.page > 1
				a.pagination-button(href=`${pagination.baseUrl}${pagination.baseUrl.includes('?') ? '&' : '?'}page=${pagination.page - 1}`)
					i.fa-solid.fa-chevron-left
					span Anterior
			span.pagination-status Página #{pagination.page} de #{pagination.totalPages}
			if pagination.page < pagination.totalPages
				a.pagination-button(href=`${pagination.baseUrl}${pagination.baseUrl.includes('?') ? '&' : '?'}page=${pagination.page + 1}`)
					span Siguiente
					i.fa-solid.fa-chevron-right