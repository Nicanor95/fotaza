mixin wall(wall_posts, pagination)
	div.r_flex.center.wall
		each p in wall_posts
			a(href=`/post/album/${p.publicacion_id}/${p.id}`)
				div.post
					img(src=`${p.img_b64}`, width=300, height=600)
					h3 #{p.titulo}
	if pagination && pagination.totalPages > 1
		nav.r_flex.center
			if pagination.page > 1
				a(href=`${pagination.baseUrl}${pagination.baseUrl.includes('?') ? '&' : '?'}page=${pagination.page - 1}`) Anterior
			span Página #{pagination.page} de #{pagination.totalPages}
			if pagination.page < pagination.totalPages
				a(href=`${pagination.baseUrl}${pagination.baseUrl.includes('?') ? '&' : '?'}page=${pagination.page + 1}`) Siguiente