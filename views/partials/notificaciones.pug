#notificaciones
	if user
		button#btnNotificaciones.header-action-button(type="button", title="Notificaciones", aria-label="Notificaciones", aria-expanded="false", aria-controls="panelNotificaciones")
			i.fa-solid.fa-bell(aria-hidden="true")
			span#contadorNotificaciones 0
		div#panelNotificaciones.side-panel.oculto(aria-hidden="true")
			button#btnCerrarNotificaciones.side-panel-close(type="button") ✕
			h3 Notificaciones
			div#notificacionesLista
