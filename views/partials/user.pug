// Boton para crear post.
a(href="/newpost").newpost
	button
		i.fa-solid.fa-plus

div#usuario
	if user
		
		- var userpage = `/users/${user.id}`
		
		span
			a(href=userpage) #{user.nombre}
		form(action="/auth/logout", method="post")
			button(type="submit")
				i.fa-solid.fa-right-from-bracket
				label Logout
	else 
		a(href="/auth/login") Login